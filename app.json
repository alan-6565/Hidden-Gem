{
  "expo": {
    "name": "Kuppio",
    "slug": "wheres-the-tea",
    "scheme": "kuppio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.wheres-the-tea"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.wheresthetea"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kuppio needs access to your photos to attach them to reviews and posts.",
          "cameraPermission": "Kuppio needs camera access so you can take a photo or video to share."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Kuppio needs camera access so you can record a post.",
          "microphonePermission": "Kuppio needs microphone access to record sound with your videos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kuppio uses your location to show spots and distances near you."
        }
      ]
    ]
  }
}
