EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Needed for the Map tab on Android only (iOS uses Apple Maps, no key
# needed). Get one from Google Cloud Console > APIs & Services > Credentials,
# with "Maps SDK for Android" enabled, then run `npx expo prebuild -p android`
# again. See app.config.js for details. Without this, Android's Map tab
# crashes with "API key not found".
GOOGLE_MAPS_ANDROID_API_KEY=your-google-maps-android-api-key

# Social sign-in buttons stay hidden until each provider is fully set up —
# see src/lib/socialAuth.ts for the steps. Apple needs a native rebuild.
EXPO_PUBLIC_APPLE_SIGN_IN=false
EXPO_PUBLIC_GOOGLE_SIGN_IN=false
